	measure 'Colour Sales vs PY Fill' =
			
			IF (
			    ISBLANK ( [Sales vs PY %] ),
			    BLANK (),
			    IF ( [Sales vs PY %] >= 0, "#E8F4EE", "#FCEBEA" )
			)
		displayFolder: Colours
		lineageTag: 7f65b034-514b-4b74-8b4d-6e35c195928f

	measure 'Colour Platinum' =
			
			IF (
			    SELECTEDVALUE ( dim_customers[loyalty_tier] ) = "Platinum",
			    "#1F4E79",
			    "#B8C0CC"
			)
		displayFolder: Colours
		lineageTag: e5924b45-756f-4a11-aa9c-08f928b03235

	measure 'Colour Ramadan' =
			
			IF ( SELECTEDVALUE ( dim_date[Period Type] ) = "Ramadan", "#1F4E79", "#B8C0CC" )
		displayFolder: Colours
		lineageTag: 839c1b0e-718e-42c2-bf0e-b63420314c8b

	measure 'Colour Ramadan Change' =
			
			VAR _isRamadan = SELECTEDVALUE ( dim_date[Period Type] ) = "Ramadan"
			VAR _ramadan =
			    CALCULATE ( [Avg Daily Sales], REMOVEFILTERS ( dim_date[Period Type] ), dim_date[is_ramadan] = 1 )
			VAR _rest =
			    CALCULATE ( [Avg Daily Sales], REMOVEFILTERS ( dim_date[Period Type] ), dim_date[is_ramadan] = 0 )
			RETURN
			    IF (
			        _isRamadan && _rest > 0,
			        IF ( _ramadan >= _rest, "#1A7F4B", "#B42318" ),
			        "#1D2633"
			    )
		displayFolder: Colours
		lineageTag: b43d40cc-2b0e-4d9b-98d7-4b87945da3e5

	measure 'Ramadan Change Label' =
			
			VAR _isRamadan = SELECTEDVALUE ( dim_date[Period Type] ) = "Ramadan"
			VAR _ramadan =
			    CALCULATE ( [Avg Daily Sales], REMOVEFILTERS ( dim_date[Period Type] ), dim_date[is_ramadan] = 1 )
			VAR _rest =
			    CALCULATE ( [Avg Daily Sales], REMOVEFILTERS ( dim_date[Period Type] ), dim_date[is_ramadan] = 0 )
			RETURN
			    IF ( _isRamadan && _rest > 0, FORMAT ( DIVIDE ( _ramadan, _rest ) - 1, "+0%;-0%" ) )
		lineageTag: 9f3d019e-8873-41ef-911d-d8a609e7c98e

	measure 'Subtitle Ret Trend' =
			
			VAR y = SELECTEDVALUE ( dim_date[year] )
			VAR legendText =
			    IF (
			        ISBLANK ( y ),
			        "Returned value as % of sales, by month of order , selected years combined",
			        "Returned value as % of sales, by month of order · Solid line: " & y & " · Dashed line: " & ( y - 1 )
			    )
			RETURN
			    legendText & " · " & [Filter Label]
		displayFolder: Titles
		lineageTag: bc1e575e-c429-4c6a-af7d-f2ff366c7f02

	column 'Measure Group'
		isHidden
		lineageTag: ba831cc5-3b7f-4e8e-80d3-ee07be3bdc97
		summarizeBy: none
		isNameInferred
		sourceColumn: [Measure Group]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source =
				DATATABLE(
				    "Measure Group", STRING,
				    {
				        {"Sales"},
				        {"Orders"},
				        {"Customers"},
				        {"Products"},
				        {"Returns"},
				        {"Performance"}
				    }
				)

	annotation PBI_Id = c3e2e890d4bf4fb6815bdd7abd648c97

