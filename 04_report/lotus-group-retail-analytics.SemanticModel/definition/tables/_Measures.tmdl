	measure 'PY Label' = "vs " & FORMAT ( SELECTEDVALUE ( dim_date[year] ) - 1, "0" )
		displayFolder: Labels
		lineageTag: 824922a7-0c19-501f-9b2c-f73ae4a044c2

	measure 'Context Label' =
			VAR y =
			    IF (
			        HASONEVALUE ( dim_date[year] ),
			        FORMAT ( VALUES ( dim_date[year] ), "0" ),
			        IF ( ISFILTERED ( dim_date[year] ), "Selected years", "2022–2024" )
			    )
			VAR r =
			    IF (
			        ISFILTERED ( dim_stores[region] ),
			        CONCATENATEX ( VALUES ( dim_stores[region] ), dim_stores[region], ", " ),
			        "All regions"
			    )
			VAR c =
			    IF (
			        ISFILTERED ( dim_products[category] ),
			        CONCATENATEX ( VALUES ( dim_products[category] ), dim_products[category], ", " ),
			        "All categories"
			    )
			RETURN
			    y & " · " & r & " · " & c
		displayFolder: Labels
		lineageTag: 36e91051-c64d-560e-9563-3fe922b677dc

	measure 'Last Refreshed Text' = "Last refreshed " & FORMAT ( MAX ( RefreshInfo[Refreshed At] ), "d mmm yyyy" )
		displayFolder: Labels
		lineageTag: bc0be782-bf72-58e5-8db2-fe4030dd6c78

