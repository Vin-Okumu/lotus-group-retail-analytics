	measure 'Cumulative Revenue Share' =
			VAR d = SELECTEDVALUE ( CustomerDecile[Decile] )
			VAR Cust =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( fact_orders[customer_id] ), "@s", [Total Sales] ),
			        [@s] > 0
			    )
			VAR n = COUNTROWS ( Cust )
			VAR k = ROUNDUP ( n * d / 10, 0 )
			RETURN
			    IF ( NOT ISBLANK ( d ) && n > 0, DIVIDE ( SUMX ( TOPN ( k, Cust, [@s], DESC ), [@s] ), SUMX ( Cust, [@s] ) ) )
		formatString: 0%
		displayFolder: Core
		lineageTag: 82f9ebcf-7021-588e-b52c-ffd5515b9bc9

	measure 'Top 20% Revenue Share' =
			VAR Cust =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( fact_orders[customer_id] ), "@s", [Total Sales] ),
			        [@s] > 0
			    )
			VAR k = INT ( COUNTROWS ( Cust ) * 0.2 )
			RETURN
			    IF ( k > 0, DIVIDE ( SUMX ( TOPN ( k, Cust, [@s], DESC ), [@s] ), SUMX ( Cust, [@s] ) ) )
		formatString: 0.0%
		displayFolder: Core
		lineageTag: 7df6794c-f31e-520f-a3c6-4dcc8adae584

	measure 'Employee Store' =
