model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 0

queryGroup Facts

	annotation PBI_QueryGroupOrder = 1

queryGroup Stagging

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Profiling and Audit'

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_date","dim_customers","dim_products","dim_employees","dim_stores","fact_orders","fact_order_details","fact_returns","fact_orders_2022_2023","fact_orders_2024","profile_ramadan_dates","profile_fact_orders","profile_dim_date_validation","audi_orders_missing_dates","audit_orders_missing_customers","audit_orders_missing_stores","audit_orders_missing_employees","audit_details_missing_order","audit_returns_missing_orders","profile__details_financial_validation"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_customers
ref table dim_date
ref table dim_employees
ref table dim_products
ref table dim_stores
ref table fact_order_details
ref table fact_returns
ref table fact_orders
ref table _Measures
ref table CustomerDecile
ref table RefreshInfo
ref table 'Share Metric'

ref cultureInfo en-US

